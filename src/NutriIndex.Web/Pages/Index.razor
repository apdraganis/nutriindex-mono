@page "/"
@inject NutriIndexApiClient Api
@inject BarcodeScannerService Scanner
@implements IAsyncDisposable

<PageTitle>NutriIndex</PageTitle>

<div class="page">
    <header class="hero">
        <h1>NutriIndex</h1>
        <p>Scan a product, enter what you paid, see cost per 100 kcal and per 100g protein.</p>
    </header>

    <section class="card">
        <h2>1. Find product</h2>

        <div class="scanner">
            <video id="barcode-video" autoplay playsinline muted></video>
            <div class="scanner-actions">
                @if (_scanning)
                {
                    <button class="btn secondary" @onclick="StopScanAsync">Stop camera</button>
                }
                else
                {
                    <button class="btn" @onclick="StartScanAsync">Scan barcode</button>
                }
            </div>
        </div>

        <div class="field">
            <label for="barcode">Or enter barcode</label>
            <div class="inline">
                <input id="barcode" @bind="_barcode" @bind:event="oninput" placeholder="e.g. 3017620422003" />
                <button class="btn" @onclick="LookupProductAsync" disabled="@_loading">Look up</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="error">@_error</p>
        }
    </section>

    @if (_product is not null)
    {
        <section class="card">
            <h2>2. Product</h2>
            <div class="product">
                @if (!string.IsNullOrWhiteSpace(_product.ImageUrl))
                {
                    <img src="@_product.ImageUrl" alt="@_product.Name" />
                }
                <div>
                    <h3>@_product.Name</h3>
                    <p class="muted">Barcode: @_product.Barcode</p>
                </div>
            </div>
        </section>

        <section class="card">
            <h2>3. Your purchase</h2>

            <div class="field">
                <label for="price">Price (EUR)</label>
                <input id="price" type="number" step="0.01" min="0" value="@_price" @oninput="e => OnDecimalInput(e, v => _price = v)" />
            </div>

            <div class="field">
                <label for="quantity">Quantity</label>
                <div class="inline">
                    <input id="quantity" type="number" step="1" min="1" value="@_quantity" @oninput="e => OnDecimalInput(e, v => _quantity = v)" />
                    <select id="unit" value="@UnitValue" @onchange="OnUnitChangedAsync">
                        <option value="g">g</option>
                        <option value="ml">ml</option>
                    </select>
                </div>
            </div>

            <div class="field">
                <label for="kcal">Kcal per @_basisLabel</label>
                <input id="kcal" type="number" step="0.1" min="0" value="@_kcalPer100" @oninput="e => OnDecimalInput(e, v => _kcalPer100 = v)" />
            </div>

            <div class="field">
                <label for="protein">Protein per @_basisLabel</label>
                <input id="protein" type="number" step="0.1" min="0" value="@_proteinPer100" @oninput="e => OnDecimalInput(e, v => _proteinPer100 = v)" />
            </div>

            @if (!HasMatchingNutrition)
            {
                <p class="warning">No nutrition for @_basisLabel — enter kcal and protein manually.</p>
            }
        </section>

        @if (_indices is not null)
        {
            <section class="results">
                <div class="result-card">
                    <span class="label">Cost per 100 kcal</span>
                    <span class="value">€@_indices.EurPer100Kcal.ToString("0.000")</span>
                </div>
                <div class="result-card">
                    <span class="label">Cost per 100g protein</span>
                    <span class="value">€@_indices.EurPer100gProtein.ToString("0.000")</span>
                </div>
            </section>
        }
        else if (_calculationError is not null)
        {
            <p class="error">@_calculationError</p>
        }
    }
</div>

@code {
    private string _barcode = string.Empty;
    private bool _loading;
    private bool _scanning;
    private string? _error;
    private string? _calculationError;
    private ProductInfo? _product;
    private Indices? _indices;
    private DotNetObjectReference<Index>? _scannerRef;

    private decimal _price;
    private decimal _quantity = 100;
    private QuantityUnit _unit = QuantityUnit.G;
    private decimal _kcalPer100;
    private decimal _proteinPer100;

    private string UnitValue => _unit == QuantityUnit.Ml ? "ml" : "g";
    private string _basisLabel => _unit == QuantityUnit.Ml ? "100ml" : "100g";

    private bool HasMatchingNutrition =>
        _product is not null && NutritionForUnit(_product, _unit) is not null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scannerRef = DotNetObjectReference.Create(this);
            if (_product is not null)
                await RecalculateAsync();
        }
    }

    private async Task StartScanAsync()
    {
        _error = null;
        try
        {
            await Scanner.StartAsync("barcode-video", _scannerRef!);
            _scanning = true;
        }
        catch (Exception ex)
        {
            _scanning = false;
            _error = string.IsNullOrWhiteSpace(ex.Message)
                ? "Could not access the camera. Enter the barcode manually."
                : ex.Message;
        }
    }

    private async Task StopScanAsync()
    {
        await Scanner.StopAsync();
        _scanning = false;
    }

    [JSInvokable]
    public void OnBarcodeDetected(string barcode)
    {
        // Return immediately to JS so camera teardown is not nested with the
        // HTTP lookup (Blazor WASM HTTP also uses JS interop and can stall).
        _ = InvokeAsync(async () =>
        {
            Console.WriteLine($"[NutriIndex] barcode received · {barcode}");
            _barcode = barcode;
            _scanning = false;
            StateHasChanged();
            await LookupProductAsync();
            StateHasChanged();
        });
    }

    private async Task LookupProductAsync()
    {
        _error = null;
        _calculationError = null;
        _indices = null;

        if (string.IsNullOrWhiteSpace(_barcode))
        {
            _error = "Enter a barcode first.";
            return;
        }

        _loading = true;
        try
        {
            _product = await Api.GetProductAsync(_barcode.Trim());
            if (_product is null)
            {
                _error = "Product not found. Try another barcode.";
                return;
            }

            ApplyProductDefaults(_product);
            await RecalculateAsync();
        }
        catch (Exception)
        {
            _error = "Could not reach the API. Is NutriIndex.Api running?";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyProductDefaults(ProductInfo product)
    {
        _unit = product.DefaultQuantityUnit
            ?? (product.NutritionPer100ml is not null && product.NutritionPer100g is null
                ? QuantityUnit.Ml
                : QuantityUnit.G);
        _quantity = product.DefaultQuantity ?? 100m;

        var nutrition = NutritionForUnit(product, _unit);
        _kcalPer100 = nutrition?.Kcal ?? 0m;
        _proteinPer100 = nutrition?.ProteinG ?? 0m;
    }

    private async Task OnUnitChangedAsync(ChangeEventArgs e)
    {
        _unit = string.Equals(e.Value?.ToString(), "ml", StringComparison.OrdinalIgnoreCase)
            ? QuantityUnit.Ml
            : QuantityUnit.G;

        if (_product is not null)
        {
            var nutrition = NutritionForUnit(_product, _unit);
            if (nutrition is not null)
            {
                _kcalPer100 = nutrition.Kcal;
                _proteinPer100 = nutrition.ProteinG;
            }
        }

        await RecalculateAsync();
    }

    private static NutritionFacts? NutritionForUnit(ProductInfo product, QuantityUnit unit) =>
        unit == QuantityUnit.Ml ? product.NutritionPer100ml : product.NutritionPer100g;

    private async Task RecalculateAsync()
    {
        _calculationError = null;
        _indices = null;

        if (_product is null || _price <= 0 || _quantity <= 0 || _kcalPer100 <= 0 || _proteinPer100 <= 0)
            return;

        try
        {
            _indices = await Api.CalculateAsync(new CalculateRequest(
                _price,
                _quantity,
                _unit,
                _kcalPer100,
                _proteinPer100));

            if (_indices is null)
                _calculationError = "Could not calculate indices.";
        }
        catch (Exception)
        {
            _calculationError = "Could not calculate indices.";
        }
    }

    private async Task OnDecimalInput(ChangeEventArgs e, Action<decimal> assign)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var value))
            assign(value);

        await RecalculateAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Scanner.StopAsync();
        _scannerRef?.Dispose();
    }
}
