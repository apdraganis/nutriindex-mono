@page "/"
@inject NutriIndexApiClient Api
@inject BarcodeScannerService Scanner
@implements IAsyncDisposable

<PageTitle>NutriIndex</PageTitle>

<div class="page">
    <header class="hero">
        <h1>NutriIndex</h1>
        <p>Scan a product, enter what you paid, see cost per 100 kcal and per 10g protein.</p>
    </header>

    <section class="card">
        <h2>1. Find product</h2>

        <div class="scanner">
            <video id="barcode-video" autoplay playsinline muted></video>
            <div class="scanner-actions">
                @if (_scanning)
                {
                    <button class="btn secondary" @onclick="StopScanAsync">Stop camera</button>
                }
                else
                {
                    <button class="btn" @onclick="StartScanAsync">Scan barcode</button>
                }
            </div>
        </div>

        <div class="field">
            <label for="barcode">Or enter barcode</label>
            <div class="inline">
                <input id="barcode" @bind="_barcode" @bind:event="oninput" placeholder="e.g. 3017620422003" />
                <button class="btn" @onclick="LookupProductAsync" disabled="@_loading">Look up</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="error">@_error</p>
        }
    </section>

    @if (_product is not null)
    {
        <section class="card">
            <h2>2. Product</h2>
            <div class="product">
                @if (!string.IsNullOrWhiteSpace(_product.ImageUrl))
                {
                    <img src="@_product.ImageUrl" alt="@_product.Name" />
                }
                <div>
                    <h3>@_product.Name</h3>
                    <p class="muted">Barcode: @_product.Barcode</p>
                </div>
            </div>
        </section>

        <section class="card">
            <h2>3. Your purchase</h2>

            <div class="field">
                <label for="price">Price (EUR)</label>
                <input id="price" type="number" step="0.01" min="0" value="@_price" @oninput="e => OnDecimalInput(e, v => _price = v)" />
            </div>

            <div class="field">
                <label for="quantity">Quantity (g)</label>
                <input id="quantity" type="number" step="1" min="1" value="@_quantityG" @oninput="e => OnDecimalInput(e, v => _quantityG = v)" />
            </div>

            <div class="field">
                <label for="kcal">Kcal per 100g</label>
                <input id="kcal" type="number" step="0.1" min="0" value="@_kcalPer100g" @oninput="e => OnDecimalInput(e, v => _kcalPer100g = v)" />
            </div>

            <div class="field">
                <label for="protein">Protein per 100g (g)</label>
                <input id="protein" type="number" step="0.1" min="0" value="@_proteinPer100g" @oninput="e => OnDecimalInput(e, v => _proteinPer100g = v)" />
            </div>

            @if (_product.Nutrition is null)
            {
                <p class="warning">Nutrition data missing — enter kcal and protein manually.</p>
            }
        </section>

        @if (_indices is not null)
        {
            <section class="results">
                <div class="result-card">
                    <span class="label">Cost per 100 kcal</span>
                    <span class="value">€@_indices.EurPer100Kcal.ToString("0.000")</span>
                </div>
                <div class="result-card">
                    <span class="label">Cost per 10g protein</span>
                    <span class="value">€@_indices.EurPer10gProtein.ToString("0.000")</span>
                </div>
            </section>
        }
        else if (_calculationError is not null)
        {
            <p class="error">@_calculationError</p>
        }
    }
</div>

@code {
    private string _barcode = string.Empty;
    private bool _loading;
    private bool _scanning;
    private string? _error;
    private string? _calculationError;
    private ProductInfo? _product;
    private Indices? _indices;

    private decimal _price;
    private decimal _quantityG = 100;
    private decimal _kcalPer100g;
    private decimal _proteinPer100g;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _product is not null)
            await RecalculateAsync();
    }

    private async Task StartScanAsync()
    {
        _error = null;
        try
        {
            await Scanner.StartAsync("barcode-video", OnBarcodeScannedAsync);
            _scanning = true;
        }
        catch (Exception)
        {
            _error = "Could not access the camera. Enter the barcode manually.";
        }
    }

    private async Task StopScanAsync()
    {
        await Scanner.StopAsync();
        _scanning = false;
    }

    private async Task OnBarcodeScannedAsync(string barcode)
    {
        _barcode = barcode;
        await StopScanAsync();
        await LookupProductAsync();
    }

    private async Task LookupProductAsync()
    {
        _error = null;
        _calculationError = null;
        _indices = null;

        if (string.IsNullOrWhiteSpace(_barcode))
        {
            _error = "Enter a barcode first.";
            return;
        }

        _loading = true;
        try
        {
            _product = await Api.GetProductAsync(_barcode.Trim());
            if (_product is null)
            {
                _error = "Product not found. Try another barcode.";
                return;
            }

            _quantityG = _product.DefaultQuantityG ?? 100m;
            _kcalPer100g = _product.Nutrition?.Kcal ?? 0m;
            _proteinPer100g = _product.Nutrition?.ProteinG ?? 0m;
            await RecalculateAsync();
        }
        catch (Exception)
        {
            _error = "Could not reach the API. Is NutriIndex.Api running?";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RecalculateAsync()
    {
        _calculationError = null;
        _indices = null;

        if (_product is null || _price <= 0 || _quantityG <= 0 || _kcalPer100g <= 0 || _proteinPer100g <= 0)
            return;

        try
        {
            _indices = await Api.CalculateAsync(new CalculateRequest(
                _price,
                _quantityG,
                _kcalPer100g,
                _proteinPer100g));

            if (_indices is null)
                _calculationError = "Could not calculate indices.";
        }
        catch (Exception)
        {
            _calculationError = "Could not calculate indices.";
        }
    }

    private async Task OnDecimalInput(ChangeEventArgs e, Action<decimal> assign)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var value))
            assign(value);

        await RecalculateAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Scanner.DisposeAsync();
    }
}
