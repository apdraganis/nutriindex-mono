{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiting": {
    "Products": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Calculate": {
      "PermitLimit": 240,
      "WindowSeconds": 60
    }
  },
  "Caching": {
    "Products": {
      "PositiveTtlSeconds": 86400,
      "NegativeTtlSeconds": 60
    }
  }
}
